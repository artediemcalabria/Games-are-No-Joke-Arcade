# VITE_AI_COACH_ENDPOINT: Public URL of the secure AI Coach backend proxy.
# Example: https://your-worker.your-account.workers.dev/api/coach
VITE_AI_COACH_ENDPOINT="your_ai_coach_proxy_url_here"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="your_app_url_here"

# GEMINI_API_KEY belongs only on the backend proxy provider.
# Do not expose it in this frontend app.
